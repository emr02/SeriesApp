@page "/notations"
@using ClientBlazorAPI.Models
@inject WSServiceNotation notationService

<PageTitle>Notations</PageTitle>

<h3>Liste des Notations</h3>

<p class="text-muted">Triées par titre de série puis nom d'utilisateur</p>

@if (notations == null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
        <p>Chargement des notations...</p>
    </div>
}
else if (notations.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Aucune notation trouvée.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Série</th>
                    <th>Utilisateur</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var notation in notations)
                {
                    <tr>
                        <td>
                            <strong>@notation.TitreSerie</strong>
                        </td>
                        <td>@notation.NomUtilisateur</td>
                        <td>
                            <span class="badge @GetBadgeClass(notation.Note)">
                                @notation.Note / 5
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <p class="text-muted">
            Total : <strong>@notations.Count</strong> notation(s)
        </p>
    </div>
}

@code {
    private List<NotationDTO>? notations;

    protected override async Task OnInitializedAsync()
    {
        notations = await notationService.GetAllNotationsAsync();
    }

    private string GetBadgeClass(int note)
    {
        return note switch
        {
            5 => "bg-success",
            4 => "bg-primary",
            3 => "bg-warning",
            2 => "bg-warning",
            _ => "bg-danger"
        };
    }
}