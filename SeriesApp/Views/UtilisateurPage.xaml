<Page
    x:Class="SeriesApp.Views.UtilisateurPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <!-- DataContext assigné dans code-behind via DI -->
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Padding="48" MinHeight="600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Utilisateur"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           Margin="12,0,0,24"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <TextBlock VerticalAlignment="Center" Text="Mail" Margin="0,0,8,0"/>
                    <TextBox Width="360"
                             Text="{Binding SearchEmail, Mode=TwoWay}"
                             PlaceholderText="ex: nom@exemple.com" />
                    <Button Content="Rechercher" Command="{Binding SearchCommand}" />
                </StackPanel>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Width="520" Spacing="8">
                    <TextBlock Text="Nom" />
                    <TextBox Text="{Binding Current.Nom, Mode=TwoWay}" />

                    <TextBlock Text="Prénom" />
                    <TextBox Text="{Binding Current.Prenom, Mode=TwoWay}" />

                    <TextBlock Text="Mobile" />
                    <TextBox Text="{Binding Current.Mobile, Mode=TwoWay}" />

                    <TextBlock Text="Mail" />
                    <TextBox Text="{Binding Current.Mail, Mode=TwoWay}" />

                    <TextBlock Text="Password" />
                    <!-- PasswordBox.Password n'est pas un DP bindable : on utilise l'événement PasswordChanged -->
                    <PasswordBox x:Name="PasswordBox"
                                 PasswordChar="●"
                                 PasswordChanged="PasswordBox_PasswordChanged" />

                    <TextBlock Text="Adresse (Rue, CP, Ville, Pays)" />
                    <TextBox Text="{Binding Current.Adresse, Mode=TwoWay}" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- CommandBar demandée dans l'énoncé -->
                <CommandBar Grid.Row="3" x:Name="AppCommandBar"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,12">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton Name="Save"
                                      Icon="Save"
                                      Label="Save Change"
                                      Command="{Binding BtnModifyUtilisateurCommand}" />
                        <AppBarButton Name="Clear"
                                      Icon="ClearSelection"
                                      Label="Clear"
                                      Command="{Binding BtnClearUtilisateurCommand}" />
                        <AppBarButton Name="Add"
                                      Icon="Add"
                                      Label="Add"
                                      Command="{Binding BtnAddUtilisateurCommand}" />
                        <AppBarButton Name="Delete"
                                      Icon="Delete"
                                      Label="Delete"
                                      Command="{Binding BtnDeleteUtilisateurCommand}" />
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>